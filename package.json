{
  "name": "neverdrop",
  "version": "1.1.0",
  "description": "SPaDe Corp NeverDrop AI — multi-model AI workspace with provider continuity, MCP integrations, and local conversation history",
  "main": "electron/main.js",
  "author": "SPaDe Corp",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "start": "electron .",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check electron/db/schema.js && node --check electron/ipc/chat.js && node --check electron/ipc/conversations.js && node --check electron/ipc/mcp.js && node --check electron/ipc/providers.js && node --check electron/mcp/host.js && node --check electron/providers/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "13.1.1",
    "keytar": "^7.9.0",
    "openai": "^4.67.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.duke-haderach.neverdrop",
    "productName": "NeverDrop · SPaDe Corp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/keytar/**/*"
    ],
    "npmRebuild": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "NeverDrop-SPaDe-Setup.${ext}"
    },
    "portable": {
      "artifactName": "NeverDrop-SPaDe-Portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
